rules_version = '2';

// All reads and writes go through the FastAPI backend, which uses the Admin
// SDK and bypasses these rules. The browser never talks to Firestore
// directly, so everything is closed by default. If you later add realtime
// listeners in the client (e.g. live order status), open narrowly here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Example of a safe, narrow opening for realtime order tracking:
    // match /orders/{orderId} {
    //   allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
    // }
  }
}
