# ---- Runtime -------------------------------------------------------------
ENV=development                 # development | production
# "memory" runs everything in-process with seeded demo data (no Firebase needed).
# "firestore" uses Firebase (Firestore/Auth/Storage) via firebase-admin.
DATA_BACKEND=memory
# Persist the in-memory store to disk between restarts (memory backend only).
MEMORY_PERSIST_PATH=.data/store.json

# Accept "dev:<uid>:<email>" bearer tokens. NEVER enable in production.
ALLOW_DEV_AUTH=true

CORS_ORIGINS=http://localhost:5173
# Public URL of this API. On Cloud Run the deploy workflow sets it.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Firebase ------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=        # e.g. your-project.appspot.com
# Path to a service-account JSON. On Cloud Run leave empty to use the
# attached service account (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=
# Service-account JSON inline (raw or base64), for hosts with no attached
# service account. Takes precedence over the above. Not needed on Cloud Run.
FIREBASE_CREDENTIALS_JSON=

# ---- Media ---------------------------------------------------------------
# Where uploaded images go: local | firebase | drive. Empty = firebase on the
# firestore backend, local on the memory backend. For drive, run
# `python -m scripts.drive_auth <oauth-client.json>` once to fill the rest.
MEDIA_BACKEND=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ---- Commerce ------------------------------------------------------------
CURRENCY=INR
TAX_RATE=0.18
FREE_SHIPPING_THRESHOLD=1999
STANDARD_SHIPPING_FEE=99
EXPRESS_SHIPPING_FEE=249

# ---- Payments ------------------------------------------------------------
# Comma-separated list of enabled providers: mock, cod, razorpay
PAYMENT_PROVIDERS=mock,cod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
