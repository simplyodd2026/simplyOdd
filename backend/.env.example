# ---- Runtime -------------------------------------------------------------
ENV=development                 # development | production
# "memory" runs everything in-process with seeded demo data (no Firebase needed).
# "firestore" uses Firebase (Firestore/Auth/Storage) via firebase-admin.
DATA_BACKEND=memory
# Persist the in-memory store to disk between restarts (memory backend only).
MEMORY_PERSIST_PATH=.data/store.json

# Accept "dev:<uid>:<email>" bearer tokens. NEVER enable in production.
ALLOW_DEV_AUTH=true  # local dev only; defaults to false when unset

CORS_ORIGINS=http://localhost:5173
# Public URL of this API. On Cloud Run the deploy workflow sets it.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Firebase ------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=        # e.g. your-project.appspot.com
# Path to a service-account JSON. On Cloud Run leave empty to use the
# attached service account (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=
# Service-account JSON inline (raw or base64), for hosts with no attached
# service account. Takes precedence over the above. Not needed on Cloud Run.
FIREBASE_CREDENTIALS_JSON=

# ---- Media ---------------------------------------------------------------
# Where uploaded images go: local | firebase. Empty = firebase on the
# firestore backend, local on the memory backend.
MEDIA_BACKEND=

# ---- Payments ------------------------------------------------------------
# Comma-separated list of enabled providers: mock, razorpay
PAYMENT_PROVIDERS=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Oddly Assistant (chat) ------------------------------------------------
# From https://console.groq.com/keys. Leave empty to run the assistant without an LLM:
# it then answers from the catalogue and FAQ directly (also what happens if Groq is down).
GROQ_API_KEY=
# Any tool-calling model listed under production models at https://console.groq.com/docs/models.
# GROQ_FALLBACK_MODELS (comma-separated) are tried in order when one is rate limited or retired. Free-tier limits
# are per model (8,000 tokens/min each at the time of writing), so each extra model adds capacity.
# List what your key can use: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_TOKENS=400
# Process-wide cap on Groq calls per minute; past it, replies come from the fallback. Keep it under your plan's RPM.
GROQ_MAX_CALLS_PER_MINUTE=25
# Claude API: the backup when Groq is rate limited, slow or down (https://platform.claude.com/settings/keys).
# Leave empty for no backup. Unlike Groq's free tier this is billed per token; ANTHROPIC_MAX_CALLS_PER_MINUTE caps it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_CALLS_PER_MINUTE=10
CHAT_HISTORY_LIMIT=6
CHAT_SESSION_TTL_HOURS=2
CHAT_MAX_MESSAGE_CHARS=600
CHAT_MESSAGES_PER_MINUTE=12
CHAT_MESSAGES_PER_DAY=200

# Storefront rebuilds: product pages are prerendered at build time, so catalogue changes trigger a
# Vercel build through this Deploy Hook (Vercel → Project → Settings → Git → Deploy Hooks).
# Secret: set it only on the API server, never in the frontend.
VERCEL_DEPLOY_HOOK_URL=
SITE_REBUILD_MIN_INTERVAL=120
