# Backend base URL. Leave empty in dev (Vite proxies /api to :8000).
# In production set to your Cloud Run URL, e.g. https://simplyodd-api-xxxx.a.run.app
VITE_API_URL=

# Firebase web config. Leave VITE_FIREBASE_API_KEY empty to use the built-in
# dev auth (works only against a backend with ALLOW_DEV_AUTH=true).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
